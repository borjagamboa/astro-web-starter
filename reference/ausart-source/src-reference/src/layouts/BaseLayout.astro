---
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import RevealObserver from '../components/common/RevealObserver.astro';
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  robots?: string;
  structuredData?: Record<string, unknown>;
}

const {
  title = site.defaultTitle,
  description = site.defaultDescription,
  canonical,
  image,
  robots,
  structuredData,
} = Astro.props;

const pageTitle = title === site.brandName || title.includes(site.brandName) ? title : `${title} | ${site.brandName}`;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site.url).toString();
const socialImage = image?.trim() || site.socialImage;
const ogImage = new URL(socialImage, site.url).toString();
const usesDefaultSocialImage = socialImage === site.socialImage;
const structuredDataJson = structuredData
  ? JSON.stringify(structuredData).replace(/</g, '\\u003c')
  : undefined;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={site.favicon} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {robots && <meta name="robots" content={robots} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    {usesDefaultSocialImage && <meta property="og:image:width" content="1200" />}
    {usesDefaultSocialImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {structuredDataJson && (
      <script type="application/ld+json" set:html={structuredDataJson}></script>
    )}
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <RevealObserver />
  </body>
</html>


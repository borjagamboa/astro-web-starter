---
import BaseLayout from './BaseLayout.astro';
import Section from '../components/common/Section.astro';

interface Props {
  title: string;
  description: string;
  metaTitle?: string;
  metaDescription?: string;
  eyebrow?: string;
  canonical?: string;
  robots?: string;
}

const { title, description, metaTitle, metaDescription, eyebrow, canonical, robots } = Astro.props;
---

<BaseLayout
  title={metaTitle ?? title}
  description={metaDescription ?? description}
  canonical={canonical}
  robots={robots}
>
  <Section variant="intro">
    <div class="page-header" data-reveal="up">
      {eyebrow && <p class="page-eyebrow">{eyebrow}</p>}
      <h1 class="page-title">{title}</h1>
      <p class="page-description">{description}</p>
      <slot name="intro" />
      <span class="page-rule" aria-hidden="true"></span>
    </div>
  </Section>
  <slot />
</BaseLayout>


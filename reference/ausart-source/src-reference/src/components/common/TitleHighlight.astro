---
interface Props {
  tone?: 'green' | 'pink';
}

const { tone = 'green' } = Astro.props;
---

<span class:list={['title-highlight', `title-highlight--${tone}`]}><slot /></span>

<style>
  .title-highlight {
    position: relative;
    z-index: 0;
    display: inline-block;
    white-space: nowrap;
  }

  .title-highlight::before {
    content: '';
    position: absolute;
    inset: 58% -0.08em 0.02em;
    z-index: -1;
    border-radius: 0.35em 0.16em 0.3em 0.12em;
    transform: rotate(-0.8deg);
  }

  .title-highlight--green::before {
    background: rgb(var(--brand-green-rgb) / 58%);
  }

  .title-highlight--pink::before {
    background: rgb(var(--brand-pink-rgb) / 52%);
  }

  @media (prefers-reduced-motion: reduce) {
    .title-highlight::before {
      transform: none;
    }
  }
</style>


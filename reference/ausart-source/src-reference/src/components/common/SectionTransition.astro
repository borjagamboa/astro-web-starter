---
interface Props {
  variant?: TransitionVariant;
  mobileVariant?: TransitionVariant;
  fill?: string;
  height?: string;
  mobileHeight?: string;
  flip?: boolean;
}

type TransitionVariant =
  | 'soft-wave'
  | 'low-curve'
  | 'soft-arch'
  | 'brand-soft-wave'
  | 'brand-blob'
  | 'brand-nodes'
  | 'soft-curve';

const paths = {
  'soft-wave': 'M0,52 C180,30 338,78 530,58 C710,39 846,24 1030,50 C1190,72 1302,74 1440,42 L1440,96 L0,96 Z',
  'low-curve': 'M0,70 C230,62 420,74 640,66 C850,59 1070,56 1440,68 L1440,96 L0,96 Z',
  'soft-arch': 'M0,72 C184,68 300,48 470,38 C690,25 868,27 1052,42 C1216,56 1328,62 1440,54 L1440,96 L0,96 Z',
  'brand-soft-wave': 'M0,54 C150,36 286,62 420,55 C560,47 666,26 810,38 C940,49 1030,78 1188,62 C1290,51 1368,38 1440,44 L1440,96 L0,96 Z',
  'brand-blob': 'M0,64 C154,42 252,72 382,58 C514,44 590,24 724,36 C858,48 932,76 1072,64 C1220,51 1316,30 1440,42 L1440,96 L0,96 Z',
  'brand-nodes': 'M0,66 C226,56 368,70 558,61 C746,52 880,40 1068,54 C1212,65 1328,64 1440,58 L1440,96 L0,96 Z',
  'soft-curve': 'M0,72 C240,63 428,67 642,60 C858,53 1058,50 1440,64 L1440,96 L0,96 Z',
};

const {
  variant = 'soft-wave',
  mobileVariant,
  fill = 'var(--color-bg)',
  height = 'clamp(38px, 5vw, 68px)',
  mobileHeight = 'clamp(24px, 8vw, 42px)',
  flip = false,
} = Astro.props;

const path = paths[variant];
const requestedMobileVariant = mobileVariant ?? variant;
const simplifiedMobileVariant: TransitionVariant = ['brand-soft-wave', 'brand-blob', 'brand-nodes'].includes(requestedMobileVariant)
  ? 'soft-curve'
  : requestedMobileVariant;
const mobilePath = paths[simplifiedMobileVariant];
const mobileClass = mobileVariant ?? variant;
---

<div
  class:list={[
    'section-transition',
    `section-transition--${variant}`,
    `section-transition--mobile-${mobileClass}`,
    { 'section-transition--flip': flip },
  ]}
  style={`--transition-fill: ${fill}; --transition-height: ${height}; --transition-mobile-height: ${mobileHeight};`}
  aria-hidden="true"
>
  <svg class="section-transition__desktop" viewBox="0 0 1440 96" preserveAspectRatio="none" focusable="false">
    <path
      d={path}
      fill="var(--transition-fill)"
      stroke="none"
    ></path>
  </svg>
  <svg class="section-transition__mobile" viewBox="0 0 1440 96" preserveAspectRatio="none" focusable="false">
    <path
      d={mobilePath}
      fill="var(--transition-fill)"
      stroke="none"
    ></path>
    <g class="section-transition__brand-shapes">
      <circle class="shape shape-a" cx="1110" cy="54" r="58"></circle>
      <circle class="shape shape-b" cx="1228" cy="42" r="34"></circle>
      <ellipse class="shape shape-c" cx="1018" cy="76" rx="72" ry="28"></ellipse>
    </g>
  </svg>
</div>

<style>
  .section-transition {
    position: relative;
    z-index: 1;
    height: var(--transition-height);
    margin-block: calc(var(--transition-height) * -1) -1px;
    color: var(--transition-fill);
    overflow: hidden;
    pointer-events: none;
  }

  .section-transition--flip svg {
    transform: scaleX(-1);
  }

  svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .section-transition__mobile {
    display: none;
  }

  path {
    fill: currentColor;
    stroke: none;
  }

  .section-transition__brand-shapes {
    display: none;
  }

  .shape {
    transform-origin: center;
  }

  @media (max-width: 767px) {
    .section-transition {
      height: clamp(20px, 6vw, 30px);
      margin-block: clamp(-30px, -6vw, -20px) -1px;
    }

    .section-transition__desktop {
      display: none;
    }

    .section-transition__mobile {
      display: block;
    }

    .section-transition__brand-shapes {
      display: none;
    }
  }
</style>


---
interface Props {
  variant?: 'default' | 'intro' | 'soft';
  container?: 'default' | 'home' | 'home-wide' | 'home-stage';
  class?: string;
}

const { variant = 'default', container = 'default', class: className } = Astro.props;
---

<section class:list={['section', `section-${variant}`, className]}>
  <div class:list={['section-shell', { [`section-shell--${container}`]: container !== 'default' }]}>
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block: var(--space-section);
  }

  .section-intro {
    position: relative;
    padding-block-start: clamp(2.1rem, 5vw, 3.75rem);
    padding-block-end: clamp(1.5rem, 4vw, 2.75rem);
  }

  .section-soft {
    background:
      var(--gradient-soft-section),
      var(--color-surface-brand);
  }

  .section-shell--home,
  .section-shell--home-wide,
  .section-shell--home-stage {
    width: min(calc(100% - 2rem), var(--section-container-max));
  }

  .section-shell--home {
    --section-container-max: var(--container-home);
  }

  .section-shell--home-wide {
    --section-container-max: var(--container-home-wide);
  }

  .section-shell--home-stage {
    --section-container-max: var(--container-home-stage);
  }

  @media (min-width: 720px) {
    .section-shell--home,
    .section-shell--home-wide,
    .section-shell--home-stage {
      width: min(calc(100% - 3rem), var(--section-container-max));
    }
  }

  @media (min-width: 1200px) {
    .section-shell--home,
    .section-shell--home-wide {
      width: min(calc(100% - 4rem), var(--section-container-max));
    }

    .section-shell--home-stage {
      width: min(calc(100% - 3rem), var(--section-container-max));
    }
  }
</style>


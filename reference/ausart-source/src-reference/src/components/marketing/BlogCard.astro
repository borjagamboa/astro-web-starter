---
interface Props {
  title: string;
  description: string;
  href: string;
  pubDate?: Date;
  category?: string;
  image?: string;
  imageAlt?: string;
}

const { title, description, href, pubDate, category, image, imageAlt } = Astro.props;
const dateFormatter = new Intl.DateTimeFormat('es-ES', { dateStyle: 'medium' });
---

<article class="blog-card">
  <a class="media-link" href={href} aria-label={`Leer: ${title}`}>
    {image && imageAlt ? (
      <img src={image} alt={imageAlt} loading="lazy" />
    ) : (
      <div class="image-fallback" aria-hidden="true">
        <span>[PROJECT_NAME]</span>
      </div>
    )}
  </a>
  <div class="body">
    <p class="meta">
      {category && <span>{category}</span>}
      {pubDate && <time datetime={pubDate.toISOString()}>{dateFormatter.format(pubDate)}</time>}
    </p>
    <h2><a href={href}>{title}</a></h2>
    <p>{description}</p>
  </div>
</article>

<style>
  .blog-card {
    display: flex;
    min-height: 100%;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    transition: transform 160ms ease, box-shadow 160ms ease, border-color 160ms ease;
  }

  .blog-card:hover {
    border-color: rgb(0 69 95 / 25%);
    box-shadow: var(--shadow-soft);
    transform: translateY(-2px);
  }

  .media-link {
    display: block;
    overflow: hidden;
    text-decoration: none;
  }

  img,
  .image-fallback {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .image-fallback {
    display: grid;
    place-items: center;
    background:
      linear-gradient(135deg, rgb(0 69 95 / 92%), rgb(63 127 116 / 82%)),
      var(--brand-blue);
    color: #fff;
    font-weight: 800;
  }

  .image-fallback span {
    border-bottom: 2px solid var(--brand-pink);
    padding-bottom: 0.35rem;
  }

  .body {
    flex: 1;
    display: grid;
    align-content: start;
    gap: 0.55rem;
    padding: 1.05rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  h2,
  p {
    margin: 0;
  }

  h2 {
    font-size: 1.25rem;
    line-height: 1.18;
  }

  a {
    color: var(--brand-blue);
    text-decoration: none;
  }

  a:hover {
    color: var(--brand-brown-soft);
  }
</style>


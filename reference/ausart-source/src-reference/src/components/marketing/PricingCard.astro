---
import Button from '../common/Button.astro';

interface Props {
  title: string;
  subtitle: string;
  amount: string;
  period?: string;
  bullets: string[];
  ctaLabel: string;
  featured?: boolean;
  delay?: string;
}

const {
  title,
  subtitle,
  amount,
  period,
  bullets,
  ctaLabel,
  featured = false,
  delay = '0ms',
} = Astro.props;
---

<article
  class:list={['pricing-card', { 'pricing-card--featured': featured }]}
  data-reveal="scale"
  style={`--reveal-delay: ${delay};`}
>
  <div class="pricing-card__badge-slot">
    {featured && <span class="pricing-card__badge">Opción habitual</span>}
  </div>
  <div class="pricing-card__heading">
    <h2>{title}</h2>
    <p>{subtitle}</p>
  </div>
  <p class="pricing-card__price">
    <span class="pricing-card__amount">{amount}</span>
    {period && <span class="pricing-card__period">{period}</span>}
  </p>
  <ul class="pricing-card__features">
    {bullets.map((bullet) => <li>{bullet}</li>)}
  </ul>
  <Button href="/contacto/" variant={featured ? 'primary' : 'secondary'}>{ctaLabel}</Button>
</article>

<style>
  .pricing-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    height: 100%;
    min-width: 0;
    border: 1px solid rgb(var(--brand-blue-rgb) / 11%);
    border-radius: var(--radius-3xl);
    padding: clamp(1.4rem, 3vw, 2.25rem);
    background: rgb(255 255 255 / 92%);
    box-shadow: var(--shadow-card);
    transition: transform 280ms ease-out, box-shadow 280ms ease-out;
  }

  .pricing-card--featured {
    border-color: rgb(var(--brand-blue-rgb) / 24%);
    background:
      radial-gradient(circle at 92% 8%, rgb(var(--brand-green-rgb) / 24%), transparent 31%),
      rgb(255 255 255 / 96%);
    box-shadow: 0 20px 46px rgb(var(--brand-blue-rgb) / 12%);
  }

  .pricing-card__badge-slot {
    display: flex;
    min-height: 1.75rem;
    justify-content: center;
  }

  .pricing-card__badge {
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-pill);
    padding: 0.35rem 0.7rem;
    background: rgb(var(--brand-green-rgb) / 32%);
    color: var(--brand-blue);
    font-size: var(--text-xs);
    font-weight: 800;
  }

  .pricing-card__heading {
    display: grid;
    gap: 0.55rem;
    text-align: center;
  }

  h2,
  p {
    margin: 0;
  }

  h2 {
    font-size: clamp(1.35rem, 2vw, 1.75rem);
    line-height: 1.14;
  }

  .pricing-card__heading p {
    color: var(--color-muted);
    line-height: 1.6;
  }

  .pricing-card__price {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.35rem;
    color: var(--brand-blue);
    white-space: nowrap;
  }

  .pricing-card__amount {
    font-size: clamp(2.35rem, 4vw, 3.25rem);
    font-weight: 800;
    line-height: 1;
  }

  .pricing-card__period {
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    font-weight: 750;
    line-height: 1.1;
  }

  .pricing-card__features {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    width: min(100%, 15.5rem);
    margin: 0 auto;
    padding: 0;
    list-style: none;
    text-align: left;
  }

  li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--color-muted);
    line-height: 1.55;
  }

  li::before {
    content: '';
    position: absolute;
    top: 0.62em;
    left: 0;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--brand-pink);
  }

  :global(.button) {
    width: min(100%, 15rem);
    margin-top: auto;
    margin-inline: auto;
    letter-spacing: 0;
  }

  @media (min-width: 720px) {
    .pricing-card__heading h2 {
      min-height: 2.3em;
    }

    .pricing-card__heading p {
      min-height: 3.2em;
    }
  }

  @media (min-width: 1040px) {
    .pricing-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 24px 52px rgb(var(--brand-blue-rgb) / 14%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pricing-card:hover {
      transform: none;
    }
  }
</style>


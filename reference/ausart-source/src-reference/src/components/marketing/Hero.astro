---
import Button from '../common/Button.astro';
import TitleHighlight from '../common/TitleHighlight.astro';
import { site } from '../../data/site';

interface Props {
  eyebrow?: string;
  title: string;
  highlight?: string;
  highlightTone?: 'green' | 'pink';
  description: string;
  primaryHref?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const {
  eyebrow = site.area,
  title,
  highlight,
  highlightTone = 'pink',
  description,
  primaryHref = '/primary-action/',
  secondaryHref = '/example-section/',
  secondaryLabel = '[SECONDARY_ACTION_LABEL]',
} = Astro.props;

const highlightIndex = highlight ? title.indexOf(highlight) : -1;
const titleStart = highlightIndex >= 0 ? title.slice(0, highlightIndex) : title;
const titleHighlight = highlightIndex >= 0 && highlight ? highlight : '';
const titleEnd = highlightIndex >= 0 && highlight ? title.slice(highlightIndex + highlight.length) : '';
---

<section class="hero">
  <div class="hero__media" aria-hidden="true">
    <img
      class="hero__image"
      src="/images/home/hero-reference.webp"
      alt=""
      loading="eager"
      decoding="async"
    />
  </div>
  <div class="hero__overlay" aria-hidden="true"></div>
  <div class="container hero__content">
    <div class="hero-copy">
      <p class="eyebrow">{eyebrow}</p>
      <h1>
        {titleHighlight ? (
          <>
            {titleStart}<TitleHighlight tone={highlightTone}>{titleHighlight}</TitleHighlight>{titleEnd}
          </>
        ) : (
          title
        )}
      </h1>
      <p class="lead">{description}</p>
      <div class="actions">
        <Button href={primaryHref}>{site.primaryCta}</Button>
        <Button href={secondaryHref} variant="secondary">{secondaryLabel}</Button>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    min-height: clamp(620px, 82vh, 860px);
    background-color: var(--brand-cream);
    background-repeat: no-repeat;
    background-size: cover;
    background-position: 62% center;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .hero__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% center;
    opacity: 1;
    filter: brightness(1.06) contrast(0.9) saturate(0.9);
    transform: scale(1.01);
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(circle at 18% 22%, rgb(var(--brand-pink-rgb) / 7%), transparent 32%),
      linear-gradient(90deg, rgb(var(--brand-cream-rgb) / 92%) 0%, rgb(255 255 255 / 82%) 32%, rgb(255 255 255 / 38%) 56%, rgb(255 255 255 / 10%) 82%, rgb(255 255 255 / 0%) 100%),
      linear-gradient(180deg, rgb(var(--brand-cream-rgb) / 8%) 0%, rgb(255 255 255 / 0) 58%, rgb(var(--brand-cream-rgb) / 68%) 100%);
    backdrop-filter: blur(0.6px);
  }

  .hero__content {
    position: relative;
    z-index: 2;
    display: grid;
    min-height: clamp(620px, 82vh, 860px);
    align-items: center;
    padding-block: clamp(4.5rem, 8vw, 7rem) clamp(5.5rem, 9vw, 7rem);
  }

  .hero-copy {
    position: relative;
    display: grid;
    max-width: 680px;
    min-width: 0;
    gap: clamp(0.9rem, 2vw, 1.15rem);
  }

  h1 {
    max-width: 16ch;
    margin: 0;
    color: var(--brand-blue);
    font-size: clamp(2.8rem, 6.2vw, 5rem);
    line-height: 1.02;
  }

  .lead {
    max-width: 58ch;
    color: var(--brand-brown-text);
    font-size: clamp(1.15rem, 1.55vw, 1.3rem);
    line-height: 1.62;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (min-width: 900px) {
    .hero {
      background-image: url('/images/home/hero-reference.webp');
    }

    .hero__media {
      display: none;
    }
  }

  @media (max-width: 767px) {
    .hero {
      display: grid;
      min-height: clamp(560px, 86svh, 680px);
      padding: 0;
      background-color: var(--brand-cream);
    }

    .hero__media {
      position: absolute;
      inset: 0;
      z-index: 0;
      width: auto;
      height: auto;
      margin: 0;
      border: 0;
      border-radius: 0;
      box-shadow: none;
      background: transparent;
    }

    .hero__image {
      object-position: 32% center;
      filter: brightness(1.04) contrast(0.95) saturate(0.94) blur(0.12px);
      opacity: 1;
      transform: scale(1.015);
    }

    .hero__overlay {
      display: block;
      background:
        radial-gradient(ellipse at 18% 36%, rgb(var(--brand-cream-rgb) / 82%) 0%, rgb(var(--brand-cream-rgb) / 60%) 33%, rgb(var(--brand-cream-rgb) / 18%) 62%, transparent 82%),
        linear-gradient(180deg, rgb(var(--brand-cream-rgb) / 42%) 0%, rgb(var(--brand-cream-rgb) / 16%) 38%, rgb(var(--brand-cream-rgb) / 10%) 64%, rgb(var(--brand-cream-rgb) / 58%) 100%),
        linear-gradient(90deg, rgb(255 255 255 / 50%) 0%, rgb(255 255 255 / 24%) 46%, rgb(255 255 255 / 0%) 100%);
      backdrop-filter: blur(0.8px);
    }

    .hero__content {
      min-height: clamp(560px, 86svh, 680px);
      padding-block: clamp(2.15rem, 8vw, 3.35rem) clamp(3.5rem, 12vw, 4.8rem);
      align-items: start;
    }

    .hero-copy {
      z-index: 0;
      isolation: isolate;
      max-width: min(100%, 35rem);
      gap: 0.78rem;
      border: 0;
      border-radius: 0;
      padding: 0;
      background: transparent;
      box-shadow: none;
      backdrop-filter: none;
    }

    .hero-copy::before {
      content: "";
      position: absolute;
      inset: -1.05rem -0.9rem -0.95rem -0.85rem;
      z-index: -1;
      border-radius: 2rem;
      background:
        radial-gradient(ellipse at 24% 18%, rgb(255 255 255 / 62%), transparent 58%),
        linear-gradient(115deg, rgb(var(--brand-cream-rgb) / 64%) 0%, rgb(var(--brand-cream-rgb) / 34%) 60%, transparent 100%);
      filter: blur(10px);
    }

    h1 {
      max-width: 15ch;
      font-size: clamp(2.2rem, 9.4vw, 3rem);
      line-height: 1.04;
      text-wrap: balance;
    }

    .lead {
      max-width: 31rem;
      color: var(--brand-brown-text);
      font-size: clamp(1rem, 3.9vw, 1.09rem);
      line-height: 1.56;
    }

    .actions {
      gap: 0.55rem;
      padding-top: 0.18rem;
    }

    .actions :global(.button) {
      min-height: 2.65rem;
      padding: 0.68rem 0.95rem;
      font-size: 0.96rem;
    }

  }
</style>


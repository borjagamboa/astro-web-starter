---
interface Props {
  title: string;
  description: string;
  href?: string;
  image?: string;
  imageAlt?: string;
}

const { title, description, href = '/servicios/', image, imageAlt = '' } = Astro.props;
---

<article class="card">
  {image ? (
    <img src={image} alt={imageAlt} loading="lazy" />
  ) : (
    <span aria-hidden="true"></span>
  )}
  <h3>{title}</h3>
  <p>{description}</p>
  <a href={href}>Ver detalle</a>
</article>

<style>
  .card {
    display: grid;
    min-height: 100%;
    align-content: start;
    gap: 0.7rem;
    border: 1px solid rgb(0 69 95 / 12%);
    border-radius: var(--radius-xl);
    padding: 1.15rem;
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    transition: transform 160ms ease, box-shadow 160ms ease, border-color 160ms ease;
  }

  .card:hover {
    border-color: rgb(166 211 176 / 82%);
    transform: translateY(-2px);
    box-shadow: var(--shadow-soft);
  }

  span {
    width: 42px;
    height: 4px;
    border-radius: var(--radius-pill);
    background: var(--brand-green);
  }

  img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  h3,
  p {
    margin: 0;
  }

  h3 {
    color: var(--brand-blue);
  }

  p {
    color: var(--color-muted);
  }

  a {
    color: var(--brand-blue);
    font-weight: 800;
    text-decoration: none;
  }
</style>


---
import Breadcrumbs, { type BreadcrumbItem } from '../components/navigation/Breadcrumbs.astro';
import Prose from '../components/primitives/Prose.astro';
import Section from '../components/primitives/Section.astro';
import { site } from '../data/site';
import { buildArticleSchema } from '../lib/structured-data';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  metaTitle?: string;
  metaDescription?: string;
  publishDate: Date;
  updatedDate?: Date;
  author?: string;
  tags?: readonly string[];
  breadcrumbs: readonly BreadcrumbItem[];
  canonical?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  metaTitle,
  metaDescription,
  publishDate,
  updatedDate,
  author,
  tags = [],
  breadcrumbs,
  canonical,
  image,
  imageAlt,
  noindex,
} = Astro.props;

if (image && !imageAlt?.trim()) {
  throw new Error('ArticleLayout requires imageAlt when image is set.');
}

const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const imageUrl = image && Astro.site ? new URL(image, Astro.site).href : undefined;
const articleSchema = pageUrl
  ? buildArticleSchema({
      headline: title,
      description,
      url: pageUrl,
      language: site.language,
      publishDate,
      updatedDate,
      image: imageUrl,
    })
  : undefined;
const dateFormatter = new Intl.DateTimeFormat(site.locale, { dateStyle: 'long' });
---

<BaseLayout
  title={metaTitle ?? title}
  description={metaDescription ?? description}
  canonical={canonical}
  ogImage={image}
  ogImageAlt={imageAlt}
  ogType="article"
  noindex={noindex}
  publishedTime={publishDate}
  modifiedTime={updatedDate}
  schema={articleSchema}
>
  <article>
    <Section spacing="compact" container="narrow" ariaLabelledby="article-title">
      <header class="article-header">
        <Breadcrumbs items={breadcrumbs} />
        <p class="article-eyebrow">Contenido editorial</p>
        <h1 id="article-title">{title}</h1>
        <p class="article-description">{description}</p>
        <div class="article-meta">
          <time datetime={publishDate.toISOString()}>{dateFormatter.format(publishDate)}</time>
          {updatedDate && <span>Actualizado: <time datetime={updatedDate.toISOString()}>{dateFormatter.format(updatedDate)}</time></span>}
          {author && <span>{author}</span>}
        </div>
        {tags.length > 0 && <ul class="article-tags" aria-label="Etiquetas">{tags.map((tag) => <li>{tag}</li>)}</ul>}
      </header>
    </Section>

    {image && imageAlt && (
      <Section spacing="none" container="narrow">
        <figure class="article-image"><img src={image} alt={imageAlt} loading="eager" decoding="async" /></figure>
      </Section>
    )}

    <Section spacing="normal" container="narrow">
      <Prose as="div" measure="default"><slot /></Prose>
    </Section>
  </article>
</BaseLayout>

<style>
  .article-header { display: grid; gap: var(--space-4); }
  .article-eyebrow { margin: var(--space-2) 0 0; color: var(--color-action); font-size: var(--text-xs); font-weight: 800; letter-spacing: 0.09em; text-transform: uppercase; }
  h1 { max-width: 18ch; margin: 0; font-size: clamp(2.65rem, 7vw, 5.25rem); }
  .article-description { margin: 0; color: var(--color-text-muted); font-size: var(--text-md); }
  .article-meta { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); color: var(--color-text-muted); font-size: var(--text-sm); }
  .article-tags { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: 0; padding: 0; list-style: none; }
  .article-tags li { border-radius: var(--radius-pill); padding: var(--space-1) var(--space-3); background: var(--color-action-soft); color: var(--color-heading); font-size: var(--text-xs); }
  .article-image { margin: 0; overflow: hidden; border-radius: var(--radius-media); }
  .article-image img { width: 100%; max-height: 38rem; object-fit: cover; }
</style>

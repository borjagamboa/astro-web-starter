---
import { site } from '../data/site';
import Footer from '../components/navigation/Footer.astro';
import Header from '../components/navigation/Header.astro';
import RevealObserver from '../components/utilities/RevealObserver.astro';
import Seo from '../components/utilities/Seo.astro';
import { buildOrganizationSchema, buildWebsiteSchema, type StructuredData } from '../lib/structured-data';
import type { OpenGraphType } from '../lib/seo';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: OpenGraphType;
  robots?: string;
  noindex?: boolean;
  nofollow?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
  schema?: StructuredData | readonly StructuredData[];
  includeWebsiteSchema?: boolean;
  lang?: string;
  showHeader?: boolean;
  showFooter?: boolean;
  enableReveal?: boolean;
}

const {
  title = site.name,
  description = site.description,
  canonical,
  ogTitle,
  ogDescription,
  ogImage = site.brand.socialImage?.src,
  ogImageAlt = site.brand.socialImage?.alt,
  ogType = 'website',
  robots,
  noindex = false,
  nofollow = false,
  publishedTime,
  modifiedTime,
  schema,
  includeWebsiteSchema = true,
  lang = site.language,
  showHeader = true,
  showFooter = true,
  enableReveal = true,
} = Astro.props;

const suppliedSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const baseSchemas: StructuredData[] = [];

if (Astro.site && includeWebsiteSchema) {
  baseSchemas.push(buildWebsiteSchema(site.name, Astro.site, lang));
}

if (Astro.site && site.organization) {
  baseSchemas.push(buildOrganizationSchema(site.organization.name, Astro.site, site.organization.logo));
}

const schemas = [...baseSchemas, ...suppliedSchemas];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <Seo
      title={title}
      description={description}
      canonical={canonical}
      ogTitle={ogTitle}
      ogDescription={ogDescription}
      ogImage={ogImage}
      ogImageAlt={ogImageAlt}
      ogType={ogType}
      robots={robots}
      noindex={noindex}
      nofollow={nofollow}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      schema={schemas}
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Saltar al contenido</a>
    {showHeader && <Header />}
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    {showFooter && <Footer />}
    {enableReveal && <RevealObserver />}
  </body>
</html>

---
import HeadingGroup from '../primitives/HeadingGroup.astro';
import type { FAQItem } from './types';

interface Props {
  items: readonly FAQItem[];
  heading?: string;
  eyebrow?: string;
  intro?: string;
  id?: string;
  openFirst?: boolean;
}

const { items, heading, eyebrow, intro, id, openFirst = false } = Astro.props;
const Tag = heading ? 'section' : 'div';
const headingId = id ? `${id}-title` : undefined;
const itemIds = new Set<string>();
const resolvedItems = items.map((item, index) => {
  if (!item.question.trim() || !item.answer.trim()) {
    throw new Error('FAQ items require a non-empty question and answer.');
  }

  const itemId = item.id?.trim() || (id ? `${id}-item-${index + 1}` : undefined);
  if (itemId && itemIds.has(itemId)) throw new Error(`FAQ item IDs must be unique: ${itemId}`);
  if (itemId) itemIds.add(itemId);

  return { ...item, itemId };
});
---

{items.length > 0 && (
  <Tag id={id} class="faq" aria-labelledby={heading ? headingId : undefined}>
    {heading && (
      <HeadingGroup
        title={heading}
        eyebrow={eyebrow}
        intro={intro}
        id={headingId}
        measure="default"
      />
    )}
    <div class="faq__items">
      {resolvedItems.map((item, index) => (
        <details id={item.itemId} open={openFirst && index === 0}>
          <summary>
            <span>{item.question}</span>
            <span class="faq__marker" aria-hidden="true"></span>
          </summary>
          <div class="faq__answer"><p>{item.answer}</p></div>
        </details>
      ))}
    </div>
  </Tag>
)}

<style>
  .faq {
    display: grid;
    gap: var(--space-7);
  }

  .faq__items {
    border-top: var(--border-strong);
  }

  details { border-bottom: var(--border-subtle); }

  summary {
    display: grid;
    min-height: 3.5rem;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-4);
    align-items: center;
    padding-block: var(--space-4);
    color: var(--color-heading);
    font-weight: 750;
    cursor: pointer;
  }

  summary::-webkit-details-marker { display: none; }

  summary:focus-visible {
    border-radius: var(--radius-sm);
  }

  .faq__marker {
    position: relative;
    width: 1rem;
    height: 1rem;
  }

  .faq__marker::before,
  .faq__marker::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 0.125rem;
    background: currentColor;
  }

  .faq__marker::after {
    rotate: 90deg;
    transition: rotate var(--transition-fast);
  }

  details[open] .faq__marker::after { rotate: 0deg; }

  .faq__answer {
    padding: 0 2.5rem var(--space-5) 0;
    color: var(--color-text-muted);
  }

  .faq__answer p { margin: 0; }

  @media (prefers-reduced-motion: reduce) {
    .faq__marker::after { transition: none; }
  }
</style>

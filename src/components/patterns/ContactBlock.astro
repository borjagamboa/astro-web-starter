---
import Button from '../primitives/Button.astro';
import HeadingGroup from '../primitives/HeadingGroup.astro';
import type { ContactDetail } from './types';

interface Action {
  label: string;
  href: string;
}

interface Props {
  heading?: string;
  text?: string;
  eyebrow?: string;
  phone?: string;
  email?: string;
  location?: string;
  hours?: string;
  details?: readonly ContactDetail[];
  primaryAction?: Action;
  secondaryAction?: Action;
  /** @deprecated Use primaryAction instead. */
  action?: Action;
  surface?: 'default' | 'accent' | 'inverse';
  id?: string;
  ariaLabel?: string;
  labels?: {
    phone?: string;
    email?: string;
    location?: string;
    hours?: string;
  };
}

const {
  heading,
  text,
  eyebrow,
  phone,
  email,
  location,
  hours,
  details = [],
  primaryAction,
  secondaryAction,
  action,
  surface = 'default',
  id,
  ariaLabel = 'Información de contacto',
  labels = {},
} = Astro.props;
const isValidEmail = (value: string) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
const toUsableHref = (href?: string) => {
  const value = href?.trim();
  if (!value) return undefined;
  if (/^(?:https?:\/\/|\/|#|\.\.?\/)/.test(value)) return value;
  if (value.startsWith('mailto:') && isValidEmail(value.slice(7))) return value;
  if (value.startsWith('tel:')) {
    const telephone = value.slice(4).replace(/[^+\d]/g, '');
    return /^\+?\d{6,15}$/.test(telephone) ? `tel:${telephone}` : undefined;
  }
  return undefined;
};
const normalizedPhone = phone?.replace(/[^+\d]/g, '');
const validPhone = normalizedPhone && /^\+?\d{6,15}$/.test(normalizedPhone) ? phone?.trim() : undefined;
const validEmail = email?.trim() && isValidEmail(email.trim()) ? email.trim() : undefined;
const validLocation = location?.trim() || undefined;
const validHours = hours?.trim() || undefined;
const validDetails = details
  .filter((detail) => detail.label.trim() && detail.value.trim())
  .map((detail) => ({ ...detail, href: toUsableHref(detail.href) }));
const resolvedPrimaryAction = primaryAction ?? action;
const normalizeAction = (candidate?: Action): Action | undefined => {
  const href = toUsableHref(candidate?.href);
  return candidate?.label.trim() && href ? { label: candidate.label.trim(), href } : undefined;
};
const usablePrimaryAction = normalizeAction(resolvedPrimaryAction);
const usableSecondaryAction = normalizeAction(secondaryAction);
const hasMethods = Boolean(validPhone || validEmail || validLocation || validHours || validDetails.length);
const hasActions = Boolean(usablePrimaryAction || usableSecondaryAction);
const hasForm = Astro.slots.has('form');
const hasContent = Boolean(heading?.trim() || text?.trim() || hasMethods || hasActions || Astro.slots.has('default') || hasForm);
const headingId = heading?.trim() && id ? `${id}-title` : undefined;
---

{hasContent && <section
  id={id}
  class:list={['contact-block', `contact-block--${surface}`, { 'contact-block--with-form': hasForm }]}
  aria-labelledby={headingId}
  aria-label={!headingId ? ariaLabel : undefined}
>
  <div class="contact-block__content">
    {heading?.trim() && <HeadingGroup
      eyebrow={eyebrow}
      title={heading}
      intro={text}
      id={headingId}
      tone={surface === 'inverse' ? 'inverse' : 'default'}
    />}

    {hasMethods && (
      <ul class="contact-block__methods">
        {validPhone && <li><span>{labels.phone ?? 'Teléfono'}</span><a href={`tel:${normalizedPhone}`}>{validPhone}</a></li>}
        {validEmail && <li><span>{labels.email ?? 'Email'}</span><a href={`mailto:${validEmail}`}>{validEmail}</a></li>}
        {validLocation && <li><span>{labels.location ?? 'Ubicación'}</span><strong>{validLocation}</strong></li>}
        {validHours && <li><span>{labels.hours ?? 'Horario'}</span><strong>{validHours}</strong></li>}
        {validDetails.map((detail) => (
          <li>
            <span>{detail.label}</span>
            {detail.href?.trim() ? <a href={detail.href}>{detail.value}</a> : <strong>{detail.value}</strong>}
          </li>
        ))}
      </ul>
    )}

    {hasActions && <div class="contact-block__actions">
      {usablePrimaryAction && <Button href={usablePrimaryAction.href} size="large">{usablePrimaryAction.label}</Button>}
      {usableSecondaryAction && <Button href={usableSecondaryAction.href} variant="secondary" size="large">{usableSecondaryAction.label}</Button>}
    </div>}
    <slot />
  </div>

  {hasForm && <div class="contact-block__form"><slot name="form" /></div>}
</section>}

<style>
  .contact-block {
    display: grid;
    gap: var(--space-7);
    border-radius: var(--radius-panel);
    padding: clamp(var(--space-5), 6vw, var(--space-8));
  }

  .contact-block--default { border: var(--border-subtle); background: var(--color-surface); }
  .contact-block--accent { background: var(--color-accent-soft); }
  .contact-block--inverse { background: var(--color-surface-inverse); color: var(--color-text-on-inverse); }

  .contact-block__content {
    display: grid;
    min-width: 0;
    align-content: start;
    gap: var(--space-5);
  }

  .contact-block__methods {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact-block__methods li { display: grid; gap: var(--space-1); }
  .contact-block__methods span { color: var(--color-text-muted); font-size: var(--text-xs); text-transform: uppercase; }
  .contact-block__methods a,
  .contact-block__methods strong { width: fit-content; color: inherit; overflow-wrap: anywhere; }

  .contact-block__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }

  .contact-block--inverse .contact-block__methods span { color: var(--color-text-on-inverse); }

  .contact-block__form {
    min-width: 0;
    border-radius: var(--radius-card);
    padding: var(--card-padding);
    background: var(--color-surface);
    color: var(--color-text);
  }

  @media (min-width: 52rem) {
    .contact-block--with-form { grid-template-columns: minmax(0, 0.85fr) minmax(20rem, 1.15fr); }
  }

  @media (max-width: 34rem) {
    .contact-block__actions { align-items: stretch; flex-direction: column; }
    .contact-block__actions :global(*) { width: 100%; }
  }
</style>

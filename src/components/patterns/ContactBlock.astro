---
import Button from '../primitives/Button.astro';
import HeadingGroup from '../primitives/HeadingGroup.astro';

interface Action {
  label: string;
  href: string;
}

interface Props {
  heading: string;
  text?: string;
  eyebrow?: string;
  phone?: string;
  email?: string;
  location?: string;
  action?: Action;
  surface?: 'default' | 'accent' | 'inverse';
  id?: string;
}

const {
  heading,
  text,
  eyebrow,
  phone,
  email,
  location,
  action,
  surface = 'default',
  id,
} = Astro.props;
const hasMethods = Boolean(phone || email || location || action);
const hasForm = Astro.slots.has('form');
const phoneHref = phone?.replace(/[^+\d]/g, '');
---

<section
  id={id}
  class:list={['contact-block', `contact-block--${surface}`, { 'contact-block--with-form': hasForm }]}
  aria-labelledby={id ? `${id}-title` : undefined}
>
  <div class="contact-block__content">
    <HeadingGroup
      eyebrow={eyebrow}
      title={heading}
      intro={text}
      id={id ? `${id}-title` : undefined}
      tone={surface === 'inverse' ? 'inverse' : 'default'}
    />

    {hasMethods && (
      <ul class="contact-block__methods">
        {phone && <li><span>Teléfono</span><a href={`tel:${phoneHref}`}>{phone}</a></li>}
        {email && <li><span>Email</span><a href={`mailto:${email}`}>{email}</a></li>}
        {location && <li><span>Ubicación</span><strong>{location}</strong></li>}
      </ul>
    )}

    {action && <Button href={action.href} size="large">{action.label}</Button>}
    <slot />
  </div>

  {hasForm && <div class="contact-block__form"><slot name="form" /></div>}
</section>

<style>
  .contact-block {
    display: grid;
    gap: var(--space-7);
    border-radius: var(--radius-panel);
    padding: clamp(var(--space-5), 6vw, var(--space-8));
  }

  .contact-block--default { border: var(--border-subtle); background: var(--color-surface); }
  .contact-block--accent { background: var(--color-accent-soft); }
  .contact-block--inverse { background: var(--color-surface-inverse); color: var(--color-text-on-inverse); }

  .contact-block__content {
    display: grid;
    min-width: 0;
    align-content: start;
    gap: var(--space-5);
  }

  .contact-block__methods {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact-block__methods li { display: grid; gap: var(--space-1); }
  .contact-block__methods span { color: var(--color-text-muted); font-size: var(--text-xs); text-transform: uppercase; }
  .contact-block__methods a,
  .contact-block__methods strong { width: fit-content; color: inherit; overflow-wrap: anywhere; }

  .contact-block--inverse .contact-block__methods span { color: var(--color-text-on-inverse); }

  .contact-block__form {
    min-width: 0;
    border-radius: var(--radius-card);
    padding: var(--card-padding);
    background: var(--color-surface);
    color: var(--color-text);
  }

  @media (min-width: 52rem) {
    .contact-block--with-form { grid-template-columns: minmax(0, 0.85fr) minmax(20rem, 1.15fr); }
  }
</style>

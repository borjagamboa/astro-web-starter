---
import type { ProofItem } from './types';

interface Props {
  items: readonly ProofItem[];
  treatment?: 'plain' | 'bordered' | 'accent';
  ariaLabel?: string;
}

const { items, treatment = 'plain', ariaLabel = 'Datos destacados' } = Astro.props;

if (items.length < 2 || items.length > 4) {
  throw new Error('Stats requires between 2 and 4 items.');
}

if (items.some((item) => !item.value.trim() || !item.label.trim())) {
  throw new Error('Stats items require a non-empty value and label.');
}
---

<dl class:list={['stats', `stats--${treatment}`, `stats--count-${items.length}`]} aria-label={ariaLabel}>
  {items.map((item) => (
    <div>
      <dt>{item.label}</dt>
      <dd>
        <strong class:list={{ 'stats__value--compact': item.value.length > 5 }}>{item.value}</strong>
        {(item.description || item.context) && <span>{item.description ?? item.context}</span>}
      </dd>
    </div>
  ))}
</dl>

<style>
  .stats {
    display: grid;
    margin: 0;
    border-radius: var(--radius-panel);
  }

  .stats--bordered { border: var(--border-subtle); background: var(--color-surface); }
  .stats--accent { background: var(--color-accent-soft); }

  .stats > div {
    display: grid;
    gap: var(--space-2);
    padding: clamp(var(--space-4), 4vw, var(--space-6));
  }

  .stats > div + div { border-top: var(--border-subtle); }

  dt {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  dd {
    display: grid;
    gap: var(--space-1);
    margin: 0;
  }

  dd strong {
    color: var(--color-heading);
    font-size: clamp(2rem, 7vw, 4rem);
    line-height: 1;
    overflow-wrap: anywhere;
  }

  dd strong.stats__value--compact { font-size: clamp(1.45rem, 4vw, 2.4rem); line-height: 1.1; }

  dd span { color: var(--color-text-muted); font-size: var(--text-sm); }

  @media (min-width: 38rem) {
    .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .stats > div + div { border-top: 0; border-left: var(--border-subtle); }
    .stats > div:nth-child(odd) { border-left: 0; }
    .stats > div:nth-child(n + 3) { border-top: var(--border-subtle); }
    .stats--count-3 > div:last-child { grid-column: 1 / -1; }
  }

  @media (min-width: 64rem) {
    .stats--count-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .stats--count-3 > div:last-child { grid-column: auto; }
    .stats--count-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .stats > div:nth-child(n + 2) { border-top: 0; border-left: var(--border-subtle); }
  }
</style>

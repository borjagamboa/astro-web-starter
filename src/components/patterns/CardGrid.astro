---
interface Props {
  columns?: 2 | 3 | 4;
  gap?: 'small' | 'medium' | 'large';
  align?: 'start' | 'stretch';
  width?: 'default' | 'wide' | 'full';
  ariaLabel?: string;
  class?: string;
}

const {
  columns = 3,
  gap = 'medium',
  align = 'stretch',
  width = 'full',
  ariaLabel,
  class: className,
} = Astro.props;
---

<div
  class:list={[
    'card-grid',
    `card-grid--${columns}`,
    `card-grid--${gap}`,
    `card-grid--${align}`,
    `card-grid--width-${width}`,
    className,
  ]}
  aria-label={ariaLabel}
>
  <slot />
</div>

<style>
  .card-grid {
    display: grid;
    min-width: 0;
    gap: var(--grid-gap);
  }

  .card-grid--small { --grid-gap: var(--space-4); }
  .card-grid--medium { --grid-gap: var(--space-5); }
  .card-grid--large { --grid-gap: var(--space-7); }
  .card-grid--start { align-items: start; }
  .card-grid--stretch { align-items: stretch; }
  .card-grid--width-default { max-width: var(--container-max); }
  .card-grid--width-wide { max-width: var(--container-wide); }
  .card-grid--width-full { max-width: none; }

  @media (min-width: 38rem) {
    .card-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 64rem) {
    .card-grid--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .card-grid--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .card-grid--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
</style>

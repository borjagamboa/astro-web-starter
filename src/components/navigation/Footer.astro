---
import { site, type SiteConfig } from '../../data/site';
import {
  footerNavigation,
  legalNavigation,
  type FooterNavigationConfig,
} from '../../data/navigation';
import Logo from './Logo.astro';

interface Props extends FooterNavigationConfig {
  siteConfig?: SiteConfig;
}

const {
  groups = footerNavigation,
  legalLinks = legalNavigation,
  showDescription = true,
  siteConfig = site,
} = Astro.props;

const hasContact = Boolean(siteConfig.contact?.email || siteConfig.contact?.phone || siteConfig.location);
const hasSocial = siteConfig.socialLinks.length > 0;
const currentYear = new Date().getFullYear();
const phoneHref = siteConfig.contact?.phone?.replace(/[^+\d]/g, '');
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <Logo variant="inverse" siteConfig={siteConfig} />
      {showDescription && siteConfig.description && <p>{siteConfig.description}</p>}
    </div>

    {groups.map((group) => group.items.length > 0 && (
      <nav class="footer-group" aria-label={group.label}>
        <h2>{group.label}</h2>
        <ul>
          {group.items.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>
    ))}

    {hasContact && (
      <section class="footer-group" aria-labelledby="footer-contact-title">
        <h2 id="footer-contact-title">Contacto</h2>
        <ul>
          {siteConfig.contact?.email && <li><a href={`mailto:${siteConfig.contact.email}`}>{siteConfig.contact.email}</a></li>}
          {siteConfig.contact?.phone && <li><a href={`tel:${phoneHref}`}>{siteConfig.contact.phone}</a></li>}
          {siteConfig.location && <li>{siteConfig.location}</li>}
        </ul>
      </section>
    )}

    {hasSocial && (
      <nav class="footer-group" aria-label="Redes sociales">
        <h2>Social</h2>
        <ul>
          {siteConfig.socialLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </nav>
    )}
  </div>

  <div class="site-footer__bottom">
    <p>© {currentYear} {siteConfig.name}</p>
    {legalLinks.length > 0 && (
      <nav aria-label="Información legal">
        <ul>
          {legalLinks.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>
    )}
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-footer-background);
    color: var(--color-text-on-inverse);
  }

  .site-footer__inner,
  .site-footer__bottom {
    width: min(100% - (var(--gutter) * 2), var(--container-wide));
    margin-inline: auto;
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-7);
    padding-block: var(--space-section) var(--space-7);
  }

  .site-footer__brand {
    display: grid;
    align-content: start;
    gap: var(--space-4);
  }

  .site-footer__brand p {
    margin: 0;
    color: var(--color-text-on-inverse);
  }

  .footer-group h2 {
    margin: 0 0 var(--space-4);
    color: var(--color-heading-on-inverse);
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .footer-group ul,
  .site-footer__bottom ul {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer a {
    color: var(--color-text-on-inverse);
  }

  .site-footer a:hover {
    color: var(--color-heading-on-inverse);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    border-top: 1px solid rgb(255 255 255 / 18%);
    padding-block: var(--space-5);
    font-size: var(--text-sm);
  }

  .site-footer__bottom p {
    margin: 0;
  }

  .site-footer__bottom ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  @media (min-width: 48rem) {
    .site-footer__inner {
      grid-template-columns: minmax(16rem, 2fr) repeat(3, minmax(8rem, 1fr));
    }
  }
</style>

---
import Button from '../primitives/Button.astro';
import Logo from './Logo.astro';
import {
  navigationAction,
  primaryNavigation,
  type NavigationAction,
  type NavigationItem,
} from '../../data/navigation';

interface Props {
  items?: readonly NavigationItem[];
  action?: NavigationAction | null;
  navigationLabel?: string;
  menuLabel?: string;
}

const {
  items = primaryNavigation,
  action = navigationAction,
  navigationLabel = 'Navegación principal',
  menuLabel = 'Menú',
} = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => {
  if (href.startsWith('#')) return false;
  const path = href.split('#')[0]?.replace(/\/+$/, '') || '/';
  return path === currentPath;
};
---

<header class="site-header" data-site-header>
  <div class="site-header__inner">
    <Logo />

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-navigation"
      data-menu-toggle
    >
      <span>{menuLabel}</span>
      <span class="menu-toggle__icon" aria-hidden="true"><i></i><i></i></span>
    </button>

    <nav id="primary-navigation" class="primary-navigation" aria-label={navigationLabel} data-navigation>
      <ul class="navigation-list">
        {items.map((item, index) => {
          const submenuId = `navigation-submenu-${index}`;
          return (
            <li class:list={['navigation-item', { 'navigation-item--parent': item.children?.length }]}>
              <div class="navigation-link-row">
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
                {item.children?.length && (
                  <button
                    class="submenu-toggle"
                    type="button"
                    aria-expanded="false"
                    aria-controls={submenuId}
                    aria-label={`Mostrar opciones de ${item.label}`}
                    data-submenu-toggle
                  >
                    <svg viewBox="0 0 20 20" aria-hidden="true">
                      <path d="m5 7.5 5 5 5-5"></path>
                    </svg>
                  </button>
                )}
              </div>
              {item.children?.length && (
                <ul id={submenuId} class="submenu">
                  {item.children.map((child) => (
                    <li><a href={child.href}>{child.label}</a></li>
                  ))}
                </ul>
              )}
            </li>
          );
        })}
      </ul>

      {action && (
        <div class="navigation-action">
          <Button href={action.href} size="small">{action.label}</Button>
        </div>
      )}
    </nav>
  </div>
</header>

<script>
  const desktopQuery = window.matchMedia('(min-width: 64rem)');

  document.querySelectorAll<HTMLElement>('[data-site-header]').forEach((header) => {
    const menuToggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const navigation = header.querySelector<HTMLElement>('[data-navigation]');
    const submenuToggles = header.querySelectorAll<HTMLButtonElement>('[data-submenu-toggle]');

    const closeSubmenus = () => {
      submenuToggles.forEach((toggle) => {
        toggle.setAttribute('aria-expanded', 'false');
        toggle.closest('.navigation-item')?.removeAttribute('data-submenu-open');
      });
    };

    const closeNavigation = (returnFocus = false) => {
      menuToggle?.setAttribute('aria-expanded', 'false');
      navigation?.removeAttribute('data-open');
      document.documentElement.removeAttribute('data-navigation-open');
      closeSubmenus();
      if (returnFocus) menuToggle?.focus();
    };

    menuToggle?.addEventListener('click', () => {
      const willOpen = menuToggle.getAttribute('aria-expanded') !== 'true';
      menuToggle.setAttribute('aria-expanded', String(willOpen));
      navigation?.toggleAttribute('data-open', willOpen);
      document.documentElement.toggleAttribute('data-navigation-open', willOpen && !desktopQuery.matches);
      if (!willOpen) closeSubmenus();
    });

    submenuToggles.forEach((toggle) => {
      toggle.addEventListener('click', () => {
        const item = toggle.closest<HTMLElement>('.navigation-item');
        const willOpen = toggle.getAttribute('aria-expanded') !== 'true';
        closeSubmenus();
        toggle.setAttribute('aria-expanded', String(willOpen));
        item?.toggleAttribute('data-submenu-open', willOpen);
      });
    });

    navigation?.addEventListener('click', (event) => {
      if (event.target instanceof HTMLAnchorElement) closeNavigation();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menuToggle?.getAttribute('aria-expanded') === 'true') {
        closeNavigation(true);
      }
    });

    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !header.contains(event.target)) closeNavigation();
    });

    desktopQuery.addEventListener('change', () => closeNavigation());
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    border-bottom: var(--border-subtle);
    background: var(--color-header-background);
    box-shadow: var(--shadow-header);
    backdrop-filter: blur(1rem);
  }

  .site-header__inner {
    display: grid;
    width: min(100% - (var(--gutter) * 2), var(--container-wide));
    min-height: var(--header-height);
    margin-inline: auto;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-3);
    align-items: center;
    padding-block: var(--space-3);
  }

  .menu-toggle {
    display: inline-flex;
    min-height: 2.65rem;
    align-items: center;
    gap: var(--space-2);
    border: var(--border-strong);
    border-radius: var(--radius-control);
    padding: 0.6rem 0.85rem;
    background: var(--color-surface);
    color: var(--color-heading);
    font-weight: 700;
  }

  .menu-toggle__icon {
    display: grid;
    width: 1rem;
    gap: 0.28rem;
  }

  .menu-toggle__icon i {
    display: block;
    height: 0.125rem;
    border-radius: var(--radius-pill);
    background: currentColor;
    transition: transform var(--transition-fast);
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__icon i:first-child {
    transform: translateY(0.2rem) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__icon i:last-child {
    transform: translateY(-0.2rem) rotate(-45deg);
  }

  .primary-navigation {
    display: none;
    max-height: calc(100svh - var(--header-height));
    grid-column: 1 / -1;
    gap: var(--space-4);
    border-top: var(--border-subtle);
    padding-block: var(--space-3) var(--space-2);
    overflow-y: auto;
  }

  .primary-navigation[data-open] {
    display: grid;
  }

  .navigation-list,
  .submenu {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .navigation-list {
    display: grid;
    gap: var(--space-1);
  }

  .navigation-link-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
  }

  .navigation-link-row > a,
  .submenu a {
    display: block;
    border-radius: var(--radius-sm);
    color: var(--color-heading);
    font-weight: 650;
    text-decoration: none;
  }

  .navigation-link-row > a {
    padding: 0.7rem 0.25rem;
  }

  .navigation-link-row > a[aria-current='page'] {
    color: var(--color-action);
  }

  .submenu-toggle {
    display: grid;
    width: 2.65rem;
    height: 2.65rem;
    place-items: center;
    border: 0;
    border-radius: var(--radius-control);
    background: var(--color-action-soft);
    color: var(--color-action);
  }

  .submenu-toggle svg {
    width: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
    transition: transform var(--transition-fast);
  }

  .submenu-toggle[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }

  .submenu {
    display: none;
    gap: var(--space-1);
    border-left: 0.125rem solid var(--color-accent);
    margin: var(--space-1) 0 var(--space-2);
    padding-left: var(--space-3);
  }

  .navigation-item[data-submenu-open] .submenu {
    display: grid;
  }

  .submenu a {
    padding: 0.55rem 0.7rem;
    color: var(--color-text-muted);
  }

  .navigation-link-row > a:hover,
  .submenu a:hover {
    background: var(--color-action-soft);
    color: var(--color-action-hover);
  }

  .navigation-action {
    padding-top: var(--space-2);
  }

  :global(html[data-navigation-open]) {
    overflow: hidden;
  }

  @media (min-width: 64rem) {
    .site-header__inner {
      grid-template-columns: auto minmax(0, 1fr);
      gap: clamp(var(--space-5), 4vw, var(--space-7));
    }

    .menu-toggle {
      display: none;
    }

    .primary-navigation {
      display: flex;
      min-width: 0;
      max-height: none;
      grid-column: auto;
      align-items: center;
      justify-content: flex-end;
      gap: clamp(var(--space-3), 2vw, var(--space-5));
      border: 0;
      padding: 0;
      overflow: visible;
    }

    .navigation-list {
      display: flex;
      min-width: 0;
      align-items: center;
      gap: var(--space-1);
    }

    .navigation-item {
      position: relative;
    }

    .navigation-link-row {
      display: block;
    }

    .navigation-link-row > a {
      padding: 0.65rem 0.75rem;
      white-space: nowrap;
      font-size: var(--text-sm);
    }

    .submenu-toggle {
      display: none;
    }

    .submenu {
      position: absolute;
      top: calc(100% + 0.35rem);
      left: 0;
      z-index: var(--z-dropdown);
      min-width: 14rem;
      border: var(--border-subtle);
      border-radius: var(--radius-md);
      margin: 0;
      padding: var(--space-2);
      background: var(--color-surface);
      box-shadow: var(--shadow-md);
    }

    .navigation-item--parent:hover .submenu,
    .navigation-item--parent:focus-within .submenu {
      display: grid;
    }

    .navigation-action {
      flex: 0 0 auto;
      padding: 0;
    }
  }
</style>

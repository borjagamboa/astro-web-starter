---
import { buildSeo, type OpenGraphType } from '../../lib/seo';
import type { StructuredData } from '../../lib/structured-data';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: OpenGraphType;
  robots?: string;
  noindex?: boolean;
  nofollow?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
  schema?: StructuredData | readonly StructuredData[];
}

const resolved = buildSeo({
  ...Astro.props,
  pathname: Astro.url.pathname,
  siteUrl: Astro.site,
});
const schemas = Astro.props.schema
  ? (Array.isArray(Astro.props.schema) ? Astro.props.schema : [Astro.props.schema])
  : [];
const jsonLd = schemas.map((item) => JSON.stringify(item).replace(/</g, '\\u003c'));
---

<title>{resolved.title}</title>
<meta name="description" content={resolved.description} />
<meta name="robots" content={resolved.robots} />
{resolved.canonical && <link rel="canonical" href={resolved.canonical} />}

<meta property="og:type" content={resolved.ogType} />
<meta property="og:title" content={resolved.ogTitle} />
<meta property="og:description" content={resolved.ogDescription} />
{resolved.canonical && <meta property="og:url" content={resolved.canonical} />}
{resolved.ogImage && <meta property="og:image" content={resolved.ogImage} />}
{resolved.ogImageAlt && <meta property="og:image:alt" content={resolved.ogImageAlt} />}
{resolved.ogType === 'article' && Astro.props.publishedTime && (
  <meta property="article:published_time" content={Astro.props.publishedTime.toISOString()} />
)}
{resolved.ogType === 'article' && Astro.props.modifiedTime && (
  <meta property="article:modified_time" content={Astro.props.modifiedTime.toISOString()} />
)}

{jsonLd.map((value) => <script type="application/ld+json" set:html={value} />)}

---
interface Props {
  as?: 'article' | 'div' | 'section';
  measure?: 'narrow' | 'default' | 'wide';
  class?: string;
}

const { as = 'div', measure = 'default', class: className } = Astro.props;
const Tag = as;
---

<Tag class:list={['prose', `prose--${measure}`, className]}><slot /></Tag>

<style>
  .prose {
    max-width: var(--prose-measure);
    color: var(--color-text);
  }

  .prose--narrow { --prose-measure: 58ch; }
  .prose--default { --prose-measure: var(--measure-copy); }
  .prose--wide { --prose-measure: 82ch; }

  .prose :global(* + :is(p, ul, ol, blockquote, figure, table)) { margin-top: var(--space-5); }
  .prose :global(:is(h2, h3, h4)) { margin-top: var(--space-7); margin-bottom: var(--space-4); }
  .prose :global(h2) { font-size: clamp(1.75rem, 4vw, 2.65rem); }
  .prose :global(h3) { font-size: clamp(1.3rem, 2.5vw, 1.75rem); }
  .prose :global(p) { margin-bottom: 0; }

  .prose :global(:is(ul, ol)) {
    display: grid;
    gap: var(--space-2);
    padding-left: 1.35rem;
  }

  .prose :global(blockquote) {
    margin-inline: 0;
    border-left: 0.25rem solid var(--color-secondary);
    padding: var(--space-3) 0 var(--space-3) var(--space-5);
    color: var(--color-heading);
    font-size: var(--text-lg);
  }

  .prose :global(blockquote p) { margin: 0; }

  .prose :global(table) {
    display: block;
    width: 100%;
    max-width: 100%;
    border-collapse: collapse;
    overflow-x: auto;
    white-space: nowrap;
  }

  .prose :global(:is(th, td)) {
    border-bottom: var(--border-subtle);
    padding: var(--space-3) var(--space-4);
    text-align: left;
  }

  .prose :global(th) { color: var(--color-heading); background: var(--color-surface-subtle); }
  .prose :global(img) { margin-inline: auto; border-radius: var(--radius-media); }
</style>

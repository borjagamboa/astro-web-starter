---
interface Props {
  eyebrow?: string;
  title?: string;
  intro?: string;
  level?: 'h1' | 'h2' | 'h3';
  align?: 'start' | 'center';
  measure?: 'compact' | 'default' | 'wide';
  tone?: 'default' | 'inverse';
  scale?: 'standard' | 'display';
  id?: string;
  class?: string;
}

const {
  eyebrow,
  title,
  intro,
  level = 'h2',
  align = 'start',
  measure = 'default',
  tone = 'default',
  scale = 'standard',
  id,
  class: className,
} = Astro.props;
const Heading = level;

if (!title?.trim() && !Astro.slots.has('title')) {
  throw new Error('HeadingGroup requires a title prop or title slot.');
}
---

<div class:list={[
  'heading-group',
  `heading-group--${align}`,
  `heading-group--${measure}`,
  `heading-group--${tone}`,
  `heading-group--${scale}`,
  className,
]}>
  {eyebrow && <p class="heading-group__eyebrow">{eyebrow}</p>}
  <Heading id={id}><slot name="title">{title}</slot></Heading>
  {intro && <p class="heading-group__intro">{intro}</p>}
  <slot />
</div>

<style>
  .heading-group {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure-heading);
  }

  .heading-group--compact { --measure-heading: 32rem; }
  .heading-group--default { --measure-heading: 44rem; }
  .heading-group--wide { --measure-heading: 58rem; }

  .heading-group--center {
    margin-inline: auto;
    justify-items: center;
    text-align: center;
  }

  .heading-group__eyebrow {
    margin: 0;
    color: var(--color-action);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .heading-group :global(:is(h1, h2, h3)) {
    margin: 0;
  }

  .heading-group--standard :global(h1) { font-size: clamp(2.5rem, 6vw, 4.5rem); }
  .heading-group--standard :global(h2) { font-size: clamp(1.9rem, 4vw, 3.25rem); }
  .heading-group--standard :global(h3) { font-size: clamp(1.35rem, 2.4vw, 2rem); }
  .heading-group--display :global(h1) { font-size: clamp(2.65rem, 7vw, 5.75rem); }

  .heading-group__intro {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-md);
  }

  .heading-group--inverse .heading-group__eyebrow { color: var(--color-accent); }
  .heading-group--inverse .heading-group__intro { color: var(--color-text-on-inverse); }
  .heading-group--inverse :global(:is(h1, h2, h3)) { color: var(--color-heading-on-inverse); }
</style>

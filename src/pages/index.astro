---
import BaseLayout from '../layouts/BaseLayout.astro';
import ActionPanel from '../components/patterns/ActionPanel.astro';
import Card from '../components/patterns/Card.astro';
import CardGrid from '../components/patterns/CardGrid.astro';
import Hero from '../components/patterns/Hero.astro';
import SplitContent from '../components/patterns/SplitContent.astro';
import HeadingGroup from '../components/primitives/HeadingGroup.astro';
import Highlight from '../components/primitives/Highlight.astro';
import Section from '../components/primitives/Section.astro';
import SectionDivider from '../components/primitives/SectionDivider.astro';
import { site } from '../data/site';

const gridImage = {
  src: '/images/starter-grid.svg',
  width: 1600,
  height: 1000,
  alt: 'Composición abstracta azul con retícula, círculo y formas geométricas',
};

const orbitImage = {
  src: '/images/starter-orbit.svg',
  width: 1600,
  height: 1200,
  alt: 'Composición abstracta de círculos, líneas y un rectángulo sobre fondo oscuro',
};
---

<BaseLayout title={`${site.name} · Patterns de composición`}>
  <Hero
    id="composicion"
    eyebrow="Escaparate temporal · Fase de patterns"
    text="La misma base puede producir composiciones sobrias, editoriales o expresivas cambiando unas pocas decisiones de layout y tema."
    primaryAction={{ label: 'Examinar las cards', href: '#cards' }}
    secondaryAction={{ label: 'Ver texto + imagen', href: '#texto-media' }}
    image={gridImage}
    surface="accent"
    size="large"
    textWidth="wide"
  >
    <Fragment slot="title">Bloques con estructura; <Highlight tone="secondary">direcciones abiertas.</Highlight></Fragment>
    <p class="development-note">Contenido ficticio para evaluar el sistema. No representa una web publicable.</p>
  </Hero>

  <SectionDivider shape="angle" from="accent" to="default" flip />

  <Section id="cards" spacing="spacious" container="wide" ariaLabelledby="cards-title">
    <HeadingGroup
      eyebrow="Un contrato, varios usos"
      title="Cards que cambian de voz sin cambiar de componente."
      intro="Media, jerarquía, tratamiento y contenido son decisiones independientes. Estos ejemplos son deliberadamente distintos y no describen productos reales."
      id="cards-title"
      measure="wide"
    />

    <CardGrid columns={3} gap="large" ariaLabel="Tres tratamientos de Card" class="pattern-grid">
      <Card
        eyebrow="Muestra 01"
        title="Entrada visual"
        text="Una composición con media puede presentar un proyecto, una pieza editorial o un producto."
        image={orbitImage}
        href="#texto-media"
        linkLabel="Continuar la muestra"
        treatment="elevated"
      />
      <Card
        eyebrow="Muestra 02"
        badge="Borde"
        title="Contenido estructurado"
        text="El mismo patrón funciona sin imagen cuando la jerarquía del texto debe dominar."
        href="#cta"
        linkLabel="Ver el cierre"
        treatment="bordered"
      >
        <ul class="card-notes">
          <li>Slots opcionales</li>
          <li>Altura coherente en grid</li>
        </ul>
      </Card>
      <Card
        eyebrow="Muestra 03"
        title="Tratamiento editorial"
        text="La variante quiet elimina el contenedor visual y deja que espacio, tipografía y ritmo construyan el carácter."
        treatment="quiet"
      >
        <p slot="footer">El footer solo aparece cuando existe contenido.</p>
      </Card>
    </CardGrid>
  </Section>

  <SplitContent
    id="texto-media"
    eyebrow="Orden reversible"
    title="La imagen inicia la lectura; el texto explica la intención."
    text="SplitContent decide orden, superficie y alineación sin asumir servicios, sectores ni tipos de página. En móvil conserva una secuencia clara y apilada."
    action={{ label: 'Ir al ActionPanel', href: '#cta' }}
    image={orbitImage}
    mediaPosition="start"
    surface="inverse"
    spacing="spacious"
  >
    <ul class="split-notes">
      <li>Orden explícito, no trucos visuales.</li>
      <li>Media con dimensiones reservadas.</li>
      <li>Contenido adicional mediante slot.</li>
    </ul>
  </SplitContent>

  <Section surface="muted" spacing="spacious" container="wide" ariaLabelledby="contrast-title">
    <div class="contrast-layout">
      <HeadingGroup
        eyebrow="Cambio de cadencia"
        title="No todos los bloques necesitan una caja."
        intro="Una sección estrecha y centrada puede romper la repetición de splits y grids sin añadir otro pattern."
        id="contrast-title"
        align="center"
        measure="compact"
      />
      <p class="display-sample" aria-hidden="true">Aa</p>
    </div>
  </Section>

  <Section id="cta" spacing="spacious" container="wide" ariaLabelledby="cta-title">
    <HeadingGroup
      eyebrow="Cierre configurable"
      title="Una acción puede ser franja, panel o foco final."
      intro="El énfasis procede de superficie, alineación y elevación; el componente no presupone la conversión ni el negocio."
      id="cta-title"
      measure="wide"
    />
    <ActionPanel
      heading="Fin de la composición de prueba."
      text="Los destinos también son ficticios: sirven para comprobar agrupación, contraste y comportamiento responsive."
      eyebrow="ActionPanel destacado"
      primaryAction={{ label: 'Volver al Hero', href: '#composicion' }}
      secondaryAction={{ label: 'Revisar las cards', href: '#cards' }}
      surface="accent"
      alignment="split"
      emphasis="featured"
    />
  </Section>

  <Section surface="inverse" spacing="compact" container="narrow" ariaLabelledby="demo-end-title">
    <HeadingGroup
      eyebrow="Solo desarrollo"
      title="La página demuestra composición; no vende el starter."
      intro="Antes de publicar un proyecto real deben sustituirse contenido, navegación, tema y assets de demostración."
      id="demo-end-title"
      align="center"
      measure="default"
    />
  </Section>
</BaseLayout>

<style>
  .development-note {
    margin: 0;
    border-left: 0.2rem solid var(--color-secondary);
    padding-left: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .pattern-grid {
    margin-top: var(--space-7);
  }

  .card-notes,
  .split-notes {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-2) 0 0;
    padding-left: 1.2rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .split-notes {
    color: var(--color-text-on-inverse);
  }

  .contrast-layout {
    display: grid;
    justify-items: center;
    gap: var(--space-7);
  }

  .display-sample {
    margin: 0;
    color: var(--color-action);
    font-size: clamp(7rem, 24vw, 16rem);
    font-weight: 850;
    letter-spacing: -0.09em;
    line-height: 0.72;
  }

  #cta > :global(.section__inner) > :global(.action-panel) {
    margin-top: var(--space-7);
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import ActionPanel from '../components/patterns/ActionPanel.astro';
import Card from '../components/patterns/Card.astro';
import CardGrid from '../components/patterns/CardGrid.astro';
import ContentSplit from '../components/patterns/ContentSplit.astro';
import ContactBlock from '../components/patterns/ContactBlock.astro';
import FAQ from '../components/patterns/FAQ.astro';
import Hero from '../components/patterns/Hero.astro';
import SectionHeading from '../components/patterns/SectionHeading.astro';
import Stats from '../components/patterns/Stats.astro';
import Testimonial from '../components/patterns/Testimonial.astro';
import type { FAQItem, ProofItem, TestimonialData } from '../components/patterns/types';
import Button from '../components/primitives/Button.astro';
import Section from '../components/primitives/Section.astro';
import SectionDivider from '../components/primitives/SectionDivider.astro';
import { site } from '../data/site';

const gridImage = { src: '/images/starter-grid.svg', width: 1600, height: 1000, alt: 'Retícula abstracta de demostración' };
const orbitImage = { src: '/images/starter-orbit.svg', width: 1600, height: 1200, alt: 'Órbitas abstractas de demostración' };
const proofItems = [
  { value: 'Tipado', label: 'Contratos', description: 'Contenido explícito y comprobable desde cada proyecto.' },
  { value: '2–4', label: 'Elementos', description: 'La retícula se adapta a la cantidad real disponible.' },
  { value: 'Sin JS', label: 'Base funcional', description: 'La información permanece visible sin hidratación.' },
] satisfies readonly ProofItem[];
const showcaseQuote = {
  quote: 'Una cita breve puede aportar contexto sin imponer una fuente, una puntuación ni una plataforma.',
  name: 'Nombre de demostración',
  role: 'Contexto editorial ficticio',
  source: { label: 'Contenido interno del showcase' },
  publicable: true,
} satisfies TestimonialData;
const faqItems = [
  {
    id: 'faq-native',
    question: '¿Necesita JavaScript para abrir una respuesta?',
    answer: 'No. El pattern utiliza details y summary nativos, por lo que mantiene su función básica sin JavaScript.',
  },
  {
    id: 'faq-heading',
    question: '¿Debe incluir siempre su propio título?',
    answer: 'No. Puede recibir un heading interno o colocarse bajo un SectionHeading compuesto por la página.',
  },
  {
    id: 'faq-schema',
    question: '¿Genera schema FAQPage automáticamente?',
    answer: 'No. Los datos estructurados se añaden por página únicamente cuando el contenido y su contexto lo justifican.',
  },
] satisfies readonly FAQItem[];
---

<BaseLayout title={`${site.name} · Showcase de composición`} description="Showcase interno de patrones visuales reutilizables del starter.">
  <Hero
    id="inicio"
    layout="split"
    size="large"
    surface="accent"
    eyebrow="Showcase interno · Hero split"
    title="Una base visual capaz de cambiar de voz."
    text="La composición separa contenido y medio sin fijar una marca, un sector ni una dirección artística definitiva."
    primaryAction={{ label: 'Explorar variantes', href: '#heroes' }}
    secondaryAction={{ label: 'Ver la retícula', href: '#grid' }}
    image={gridImage}
    textWidth="wide"
  >
    <p class="demo-note">Contenido local y ficticio para revisar el sistema, no para publicar.</p>
  </Hero>

  <Section id="heroes" spacing="compact" container="wide" ariaLabelledby="heroes-title">
    <SectionHeading
      id="heroes-title"
      eyebrow="Tres estructuras reales"
      title="El Hero cambia la composición, no solo la alineación."
      text="Split, centered e immersive responden a jerarquías visuales distintas y conservan la misma API editorial."
      measure="wide"
    />
  </Section>

  <Hero
    layout="centered"
    headingLevel="h2"
    size="compact"
    surface="inverse"
    eyebrow="Hero centered · Sin imagen"
    title="La tipografía también puede ocupar el centro."
    text="Una variante de alta claridad para manifiestos, lanzamientos o entradas editoriales que no necesitan un recurso visual."
    primaryAction={{ label: 'Acción principal', href: '#cta' }}
    textWidth="wide"
  >
    <div slot="decoration" class="type-decoration">02</div>
  </Hero>

  <Hero
    layout="immersive"
    headingLevel="h2"
    size="large"
    surface="inverse"
    eyebrow="Hero immersive · Medio de fondo"
    title="Una escena preparada para crecer."
    text="El contenido, el medio y la decoración viven en capas separadas para admitir futuras experiencias sin rehacer el CORE."
    primaryAction={{ label: 'Ver contenido dividido', href: '#split' }}
    secondaryAction={{ label: 'Seguir explorando', href: '#cards' }}
    image={orbitImage}
    textWidth="wide"
  />

  <ContentSplit
    id="split"
    eyebrow="ContentSplit"
    title="Ritmo editorial con control de proporción."
    text="Texto, acciones y medio siguen siendo independientes. La imagen puede cambiar de lado y de ratio sin alterar el orden semántico principal."
    image={gridImage}
    mediaPosition="start"
    mediaRatio="portrait"
    balance="media"
    surface="muted"
    spacing="spacious"
  >
    <p class="editorial-copy">El slot de contenido admite párrafos, listas o microcomposiciones propias. El pattern solo establece relación espacial y medida.</p>
    <div slot="actions" class="inline-actions">
      <Button href="#cards">Revisar cards</Button>
      <Button href="#grid" variant="ghost">Ver grid</Button>
    </div>
  </ContentSplit>

  <Section id="cards" spacing="spacious" container="wide" ariaLabelledby="cards-title">
    <SectionHeading
      id="cards-title"
      eyebrow="Card"
      title="Tres tratamientos, una estructura flexible."
      text="Los visuales, metadatos, enlaces y pies son optativos. Plain, bordered y elevated no presuponen dominio ni tipo de contenido."
      measure="wide"
    />
    <CardGrid columns={3} gap="large" ariaLabel="Tratamientos visuales de Card" class="showcase-grid">
      <Card treatment="plain" eyebrow="Plain" title="Contenido sin contenedor" text="Útil cuando la retícula y el espacio ya aportan suficiente estructura." href="#cta" linkLabel="Continuar">
        <svg slot="visual" viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="M8 34 24 8l16 26H8Z" stroke="currentColor" stroke-width="3"/><circle cx="24" cy="29" r="5" fill="currentColor"/></svg>
      </Card>
      <Card treatment="bordered" eyebrow="Bordered" badge="Meta" title="Límite explícito" text="El borde agrupa información sin elevar visualmente todo el bloque.">
        <p>El cuerpo libre puede ampliar la descripción con contenido editorial breve.</p>
      </Card>
      <Card treatment="elevated" eyebrow="Elevated" title="Medio y profundidad" text="La sombra crea una capa clara cuando la composición necesita más contraste." image={orbitImage}>
        <span slot="footer">Pie opcional de demostración</span>
      </Card>
    </CardGrid>
  </Section>

  <SectionDivider width="wide" />

  <Section id="grid" spacing="spacious" container="wide" ariaLabelledby="grid-title">
    <SectionHeading
      id="grid-title"
      eyebrow="Grid genérico"
      title="La retícula organiza cualquier bloque, no solo cards."
      text="El modo auto-fit adapta el número de columnas a un ancho mínimo semántico; el modo fijo conserva composiciones de dos, tres o cuatro columnas."
      align="center"
      measure="wide"
    />
    <CardGrid layout="auto-fit" minItemWidth="small" gap="medium" ariaLabel="Ejemplo auto-fit con cuatro bloques" class="showcase-grid metric-grid">
      <div class="metric"><strong>2</strong><span>columnas fijas</span></div>
      <div class="metric"><strong>3</strong><span>columnas fijas</span></div>
      <div class="metric"><strong>4</strong><span>columnas fijas</span></div>
      <div class="metric"><strong>Auto</strong><span>ajuste fluido</span></div>
    </CardGrid>
  </Section>

  <Section id="proof" surface="accent" spacing="spacious" container="wide" ariaLabelledby="proof-title">
    <SectionHeading
      id="proof-title"
      eyebrow="Confianza y prueba"
      title="Datos y citas sin asumir números ni plataformas."
      text="Stats admite propiedades descriptivas y Testimonial conserva atribución, fuente y publicación como datos optativos."
      measure="wide"
    />
    <div class="proof-layout">
      <Stats items={proofItems} treatment="plain" ariaLabel="Capacidades verificables del pattern" />
      <Testimonial {...showcaseQuote} treatment="quiet" />
    </div>
  </Section>

  <Section id="faq" surface="muted" spacing="spacious" container="wide" ariaLabelledby="faq-title">
    <div class="faq-layout">
      <SectionHeading
        id="faq-title"
        eyebrow="FAQ nativa"
        title="Preguntas frecuentes que funcionan antes que el JavaScript."
        text="La página controla el título; el pattern se limita a la lista accesible de preguntas y respuestas."
      />
      <FAQ items={faqItems} id="showcase-faq" openFirst={true} />
    </div>
  </Section>

  <Section id="contact" spacing="spacious" container="wide" ariaLabelledby="contact-showcase-title">
    <SectionHeading
      id="contact-showcase-title"
      eyebrow="Contacto configurable"
      title="Conversión sin formulario ni proveedor."
      text="ContactBlock muestra únicamente los canales disponibles. Este ejemplo usa datos reservados y explícitamente ficticios."
      measure="wide"
    />
    <ContactBlock
      heading="Punto de contacto de demostración"
      text="La configuración de cada proyecto decide qué vías son públicas y qué acciones tienen sentido."
      email="equipo@starter.invalid"
      hours="Horario por configurar en el proyecto"
      details={[{ label: 'Estado', value: 'Contenido ficticio de desarrollo' }]}
      primaryAction={{ label: 'Volver al inicio', href: '#inicio' }}
      secondaryAction={{ label: 'Revisar FAQ', href: '#faq' }}
      surface="default"
      id="contact-example"
    />
  </Section>

  <Section id="cta" surface="inverse" spacing="spacious" container="full" ariaLabel="Cierres de llamada a la acción">
    <div class="cta-wrap">
      <ActionPanel
        layout="band"
        emphasis="plain"
        surface="inverse"
        alignment="start"
        eyebrow="CTA band"
        heading="Un cierre ancho para una idea principal."
        text="La banda puede vivir a todo el ancho y recibir un visual propio sin imponer decoración desde el componente."
        primaryAction={{ label: 'Volver al inicio', href: '#inicio' }}
        secondaryAction={{ label: 'Revisar heroes', href: '#heroes' }}
      >
        <img slot="visual" src="/images/starter-grid.svg" width="1600" height="1000" alt="" loading="lazy" />
      </ActionPanel>
    </div>
  </Section>

</BaseLayout>

<style>
  .demo-note { margin: 0; border-left: 0.2rem solid var(--color-secondary); padding-left: var(--space-4); color: var(--color-text-muted); font-size: var(--text-sm); }
  .type-decoration { position: absolute; top: 50%; left: 50%; color: rgb(255 255 255 / 5%); font: 800 clamp(16rem, 45vw, 38rem)/0.7 var(--font-heading); translate: -50% -50%; }
  .editorial-copy { max-width: var(--measure-copy); margin: 0; color: var(--color-text-muted); }
  .inline-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .showcase-grid { margin-top: var(--space-7); }
  .metric { display: grid; min-height: 11rem; align-content: space-between; border-top: var(--border-strong); padding-block: var(--space-4); }
  .metric strong { color: var(--color-heading); font-size: var(--text-xl); }
  .metric span { color: var(--color-text-muted); }
  .proof-layout { display: grid; gap: clamp(var(--space-6), 6vw, var(--space-8)); margin-top: var(--space-7); }
  .proof-layout :global(.testimonial) { align-self: stretch; border-top: var(--border-strong); }
  .faq-layout { display: grid; gap: clamp(var(--space-6), 7vw, var(--space-8)); }
  #contact :global(.contact-block) { margin-top: var(--space-7); }
  .cta-wrap { width: 100%; }
  @media (min-width: 56rem) { .proof-layout { grid-template-columns: minmax(0, 1.5fr) minmax(17rem, 0.75fr); } .faq-layout { grid-template-columns: minmax(17rem, 0.75fr) minmax(0, 1.25fr); align-items: start; } }
  @media (max-width: 34rem) { .inline-actions { align-items: stretch; flex-direction: column; } .inline-actions :global(*) { width: 100%; } }
</style>

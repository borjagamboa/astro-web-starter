---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout>
  <section class="starter-check">
    <div class="container starter-check__panel">
      <p class="starter-check__eyebrow">Entorno de desarrollo</p>
      <h1>{site.name}</h1>
      <p class="starter-check__lead">
        La base Astro está activa. Esta página valida la configuración global, el layout y los
        design tokens; no es una página destinada a producción.
      </p>
      <dl>
        <div>
          <dt>Idioma</dt>
          <dd>{site.language}</dd>
        </div>
        <div>
          <dt>Locale</dt>
          <dd>{site.locale}</dd>
        </div>
        <div>
          <dt>Estado</dt>
          <dd>Base técnica preparada</dd>
        </div>
      </dl>
      <p class="starter-check__notice">
        Sustituye la configuración y esta página antes de publicar un proyecto real.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .starter-check {
    display: grid;
    min-height: 100vh;
    place-items: center;
    padding-block: var(--space-7);
    background:
      radial-gradient(circle at top right, var(--color-accent), transparent 36rem),
      var(--color-background);
  }

  .starter-check__panel {
    border: var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: clamp(var(--space-6), 7vw, var(--space-8));
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
  }

  .starter-check__eyebrow {
    margin: 0 0 var(--space-3);
    color: var(--color-action);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 18ch;
    margin: 0;
    font-size: var(--text-xl);
  }

  .starter-check__lead {
    margin: var(--space-5) 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-md);
  }

  dl {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-6) 0 0;
  }

  dl div {
    display: grid;
    gap: var(--space-1);
    border-top: var(--border-subtle);
    padding-top: var(--space-3);
  }

  dt {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  dd {
    margin: 0;
    color: var(--color-heading);
    font-family: var(--font-mono);
  }

  .starter-check__notice {
    margin: var(--space-6) 0 0;
    border-left: 0.25rem solid var(--color-action);
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface-subtle);
    color: var(--color-text-muted);
  }

  @media (min-width: 42rem) {
    dl {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>

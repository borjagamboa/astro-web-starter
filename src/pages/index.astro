---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactBlock from '../components/patterns/ContactBlock.astro';
import FAQ from '../components/patterns/FAQ.astro';
import FeatureGrid from '../components/patterns/FeatureGrid.astro';
import Hero from '../components/patterns/Hero.astro';
import Stats from '../components/patterns/Stats.astro';
import Testimonial from '../components/patterns/Testimonial.astro';
import CardGrid from '../components/patterns/CardGrid.astro';
import HeadingGroup from '../components/primitives/HeadingGroup.astro';
import Prose from '../components/primitives/Prose.astro';
import Section from '../components/primitives/Section.astro';
import { site } from '../data/site';

const features = [
  {
    index: 'A1',
    badge: 'Contenido',
    title: 'Capacidad indexada',
    text: 'Un número, título y texto bastan para explicar servicios, ventajas, pasos o capacidades.',
  },
  {
    index: 'B2',
    badge: 'Enlace opcional',
    title: 'Card con destino',
    text: 'El enlace aparece solo cuando existe una ruta útil y una etiqueta clara.',
    href: '#contenido',
    linkLabel: 'Ver contenido editorial',
  },
  {
    index: 'C3',
    title: 'Jerarquía flexible',
    text: 'La cantidad y el tratamiento cambian según el inventario real, sin rellenar una plantilla fija.',
  },
] as const;

const stats = [
  { value: '2–4', label: 'Datos por bloque', context: 'Un rango breve y legible en móvil.' },
  { value: '0', label: 'JavaScript para FAQ', context: 'Interacción nativa con details y summary.' },
  { value: '320 px', label: 'Ancho mínimo revisado', context: 'El contenido se apila sin perder jerarquía.' },
  { value: '1', label: 'Fuente por dato', context: 'Cada cifra real debe poder verificarse.' },
] as const;

const testimonials = [
  {
    quote: 'Texto ficticio para revisar una cita sin atribución, valoración ni fuente.',
  },
  {
    quote: 'La identidad aparece solo cuando el proyecto aporta datos públicos y autorizados.',
    name: 'Perfil ficticio A',
    context: 'Contexto de demostración',
  },
  {
    quote: 'La procedencia puede mostrarse como texto aunque no exista un enlace externo.',
    source: { label: 'Fuente de ejemplo' },
  },
] as const;

const faqItems = [
  {
    question: '¿La FAQ necesita JavaScript?',
    answer: 'No. Usa elementos details y summary, conserva el contenido visible en el HTML y funciona sin scripts.',
  },
  {
    question: '¿Deben mostrarse todos los campos opcionales?',
    answer: 'No. Cada pattern elimina de forma limpia los metadatos, enlaces, visuales o atribuciones que no recibe.',
  },
  {
    question: '¿Estas secciones forman una plantilla obligatoria?',
    answer: 'No. Este índice es un catálogo interno. En un proyecto se seleccionan y ordenan los bloques según contenido, identidad y prioridad comercial.',
  },
] as const;
---

<BaseLayout title={`${site.name} · Catálogo de contenido`}>
  <Hero
    id="catalogo"
    eyebrow="Catálogo interno · Solo desarrollo"
    title="Patterns de contenido preparados para combinarse."
    text="Features, evidencia, preguntas, contacto y lectura larga comparten una base accesible sin imponer la forma de una web final."
    primaryAction={{ label: 'Ver features', href: '#features' }}
    secondaryAction={{ label: 'Revisar FAQ', href: '#faq' }}
    surface="accent"
    size="compact"
    textWidth="wide"
  >
    <p class="development-note">Todos los textos, perfiles y cifras de esta página son material explícito de demostración.</p>
  </Hero>

  <Section id="features" spacing="spacious" container="wide" ariaLabelledby="features-title">
    <HeadingGroup
      eyebrow="Oferta y proceso"
      title="Una base para servicios, ventajas, capacidades o pasos."
      intro="El pattern reutiliza Card y CardGrid. Puede mostrar índice, badge, visual y enlace sin exigir ninguno de ellos."
      id="features-title"
      measure="wide"
    />
    <div class="pattern-content">
      <FeatureGrid items={features} columns={3} gap="large" showIndex ariaLabel="Tres variantes de feature" />
    </div>
  </Section>

  <Section id="evidencia" surface="muted" spacing="spacious" container="wide" ariaLabelledby="evidence-title">
    <HeadingGroup
      eyebrow="Evidencia estructurada"
      title="Datos y testimonios solo cuando existe una fuente real."
      intro="La demo usa cifras técnicas del propio catálogo y atribuciones marcadas como ficticias; ningún dato debe trasladarse a producción."
      id="evidence-title"
      measure="wide"
    />
    <div class="pattern-content evidence-stack">
      <Stats items={stats} treatment="bordered" ariaLabel="Características técnicas del catálogo" />
      <CardGrid columns={3} gap="medium" ariaLabel="Variantes de testimonio ficticio">
        {testimonials.map((item) => <Testimonial {...item} />)}
      </CardGrid>
    </div>
  </Section>

  <Section spacing="spacious" container="narrow">
    <FAQ
      id="faq"
      eyebrow="Interacción nativa"
      heading="Preguntas frecuentes sin depender de scripts."
      intro="Cada respuesta procede de un único array de datos y conserva semántica de documento."
      items={faqItems}
      openFirst
    />
  </Section>

  <Section id="contenido" surface="accent" spacing="spacious" container="narrow" ariaLabelledby="content-title">
    <HeadingGroup
      eyebrow="Lectura larga"
      title="Ritmo editorial con una medida controlada."
      intro="Prose aplica una base consistente a contenido semántico sin convertirse en un CMS ni imponer su estructura."
      id="content-title"
    />
    <Prose as="article" class="pattern-content">
      <h2>Un cuerpo de contenido predecible</h2>
      <p>Los párrafos mantienen una longitud cómoda. Los títulos, listas, enlaces, citas, imágenes y tablas básicas reciben estilos coherentes dentro de este contexto.</p>
      <h3>Qué puede contener</h3>
      <ul>
        <li>Secciones con jerarquía de títulos.</li>
        <li>Listas ordenadas o sin ordenar.</li>
        <li><a href="#contacto">Enlaces reconocibles y con foco visible</a>.</li>
      </ul>
      <blockquote><p>Una cita editorial es contenido; no implica que exista una persona testimonial.</p></blockquote>
      <table>
        <thead><tr><th>Medida</th><th>Uso sugerido</th></tr></thead>
        <tbody>
          <tr><td>Estrecha</td><td>Lectura continua</td></tr>
          <tr><td>Amplia</td><td>Tablas o contenido mixto</td></tr>
        </tbody>
      </table>
    </Prose>
  </Section>

  <Section spacing="spacious" container="wide">
    <ContactBlock
      id="contacto"
      eyebrow="Cierre visual"
      heading="Contacto directo o espacio para una integración futura."
      text="Teléfono, email, ubicación, CTA y formulario son opcionales. La demo no configura destinos reales."
      action={{ label: 'Volver al catálogo', href: '#catalogo' }}
      surface="inverse"
    >
      <div slot="form" class="form-placeholder" aria-label="Vista previa del slot de formulario">
        <strong>Slot de formulario</strong>
        <p>Reserva visual sin proveedor, backend ni envío activo.</p>
        <span>Campo futuro</span>
        <span>Mensaje futuro</span>
      </div>
    </ContactBlock>
  </Section>
</BaseLayout>

<style>
  .development-note {
    margin: 0;
    border-left: 0.2rem solid var(--color-secondary);
    padding-left: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .pattern-content { margin-top: var(--space-7); }

  .evidence-stack {
    display: grid;
    gap: var(--space-7);
  }

  .form-placeholder {
    display: grid;
    gap: var(--space-3);
  }

  .form-placeholder p { margin: 0; color: var(--color-text-muted); }

  .form-placeholder span {
    display: block;
    border: var(--border-subtle);
    border-radius: var(--radius-control);
    padding: var(--space-4);
    color: var(--color-text-muted);
    background: var(--color-surface-subtle);
  }
</style>
